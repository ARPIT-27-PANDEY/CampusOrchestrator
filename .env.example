# CampusOS AI configuration. Copy to .env and edit. Never commit .env.
# The backend reads these variables; the MCP servers read the *_PROVIDER / data variables.

# ---------------------------------------------------------------- Campus clock
# IANA timezone that decides "today" for the agent prompt, menus, library hours and events.
# Read by the backend AND every MCP server (each validates it at start-up). Never the host OS timezone.
CAMPUS_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------- LLM
# "mock" = deterministic offline provider (default; no key needed). "groq" = GroqCloud.
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_REASONING_EFFORT=low          # low | medium | high (GPT-OSS only)
GROQ_INCLUDE_REASONING=false       # keep reasoning tokens out of responses
GROQ_STREAM=true                   # falls back to non-streaming automatically if Groq rejects it
GROQ_TIMEOUT_S=30
GROQ_MAX_RETRIES=2                 # 429/5xx retries inside the OpenAI client (honours retry-after)

# ---------------------------------------------------------------- MCP servers (allowlisted)
# Defaults come from backend/config/mcp_servers.json. Override a URL, or set it empty to mark "not configured".
# MCP_LIBRARY_URL=http://localhost:8101/mcp
# MCP_EVENTS_URL=http://localhost:8102/mcp
# MCP_CAFETERIA_URL=http://localhost:8103/mcp
# MCP_ACADEMICS_URL=http://localhost:8104/mcp
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,library-mcp,events-mcp,cafeteria-mcp,academics-mcp

# ---------------------------------------------------------------- Agent budgets
MAX_AGENT_ITERATIONS=5
MAX_TOOL_CALLS=8
TOOL_TIMEOUT_S=8
TOOL_MAX_RETRIES=1
TOOL_EXECUTION_MODE=sequential     # GPT-OSS on Groq emits one call per turn; "concurrent" runs a turn's calls in parallel
MAX_QUERY_CHARS=2000
MAX_CONCURRENT_CHATS=4

# ---------------------------------------------------------------- API
CORS_ORIGINS=http://localhost:3000 # allowed Origin(s) for sign-in and chat POSTs (the web origin)
ALLOW_FAULT_INJECTION=false        # true enables per-request simulated outages (demo/testing only)
LOG_LEVEL=INFO
LOG_JSON=false
# APP_ENV=development              # production: Secure cookies, minimal trace retention, fail-closed access

# ---------------------------------------------------------------- Access control (docs/security.md)
ACCESS_MODE=open                   # open (local dev) | password (required in production)
ACCESS_PASSWORD=                   # shared password, >= 8 characters (password mode)
SESSION_SECRET=                    # >= 32 random characters, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
# SESSION_TTL_S=43200
# COOKIE_SECURE=                   # default: true in production; false only for local HTTP tests
# ALLOW_OPEN_ACCESS=false          # explicit override: production without a password
# TRUSTED_PROXY_HOPS=0             # proxies whose X-Forwarded-For entries are trusted (Render: 2)
# CHAT_RATE_PER_MINUTE=10
# CHAT_BURST=5
# LOGIN_RATE_PER_MINUTE=5
# READ_RATE_PER_MINUTE=120

# ---------------------------------------------------------------- Traces (docs/security.md)
TRACE_BACKEND=memory               # memory | sqlite (single instance; survives restarts)
# TRACE_DB_PATH=backend/data/traces.sqlite3
TRACE_RETENTION_HOURS=24
# TRACE_CAPACITY=200
# TRACE_STORE_QUERY_TEXT=          # default: true in development, false in production
# TRACE_STORE_TOOL_PAYLOADS=       # default: true in development, false in production
# TRACE_LOG_PATH=./traces.jsonl    # optional JSONL export (same privacy rules)

# ---------------------------------------------------------------- Data providers (MCP servers)
LIBRARY_PROVIDER=demo              # demo catalogue: Open Library-verified records, synthetic holdings
PUBLIC_BOOK_PROVIDERS=openlibrary,openstax   # empty disables discover_public_books; add googlebooks to opt in
GOOGLE_BOOKS_API_KEY=              # optional (Google Books quota)
# PUBLIC_BOOK_CACHE_TTL_S=3600
# PUBLIC_BOOK_TIMEOUT_S=8
EVENTS_PROVIDER=demo               # demo (official IITR calendar dates + labelled synthetic events) | google
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=
CAFETERIA_PROVIDER=demo            # demo (synthetic 4-week rotation) | json | pdf
CAFETERIA_MENU_PATH=
# Academics / RAG (docs/data-sources.md)
QDRANT_URL=                        # e.g. http://localhost:6333 ; empty = embedded store (QDRANT_PATH)
QDRANT_PATH=:memory:               # or a directory such as ./data/qdrant
QDRANT_COLLECTION=campus_handbooks # one collection per embedder is derived from this name
# Local default: semantic + lexical search (best measured retrieval). Needs the fastembed extra
# (pip install -e "services/academics_mcp[fastembed]" "services/library_mcp[fastembed]"; ~130 MB model on first use).
# Offline / low-memory: EMBEDDING_PROVIDER=hashing, RETRIEVAL_MODE=dense, LIBRARY_SEARCH_MODE=keyword.
EMBEDDING_PROVIDER=fastembed       # hashing (offline, lexical) | fastembed (semantic)
RETRIEVAL_MODE=hybrid              # dense | hybrid (dense + BM25, Reciprocal Rank Fusion)
LIBRARY_SEARCH_MODE=hybrid         # keyword | hybrid (keyword tiers + FastEmbed similarity, RRF)
# LIBRARY_EMBEDDER=fastembed        # or hashing (offline lexical baseline)
# LIBRARY_SEMANTIC_MIN_SCORE=0.68   # gates tuned on evals/datasets/library_search_v1.yaml (dev split)
# LIBRARY_SEMANTIC_MIN_Z=1.5
# RAG_MIN_SCORE=                   # default per embedder: hashing 0.12, fastembed 0.72
# RAG_BM25_MIN_SCORE=6.0           # hybrid mode lexical gate
# HANDBOOK_DIR=services/academics_mcp/data/iitr     # official corpus (default); data/handbooks = fictional demo
# SOURCE_MANIFEST=services/academics_mcp/data/sources/iitr_sources.yaml

# ---------------------------------------------------------------- Frontend
# The browser calls the frontend's own /api/*, proxied server-side to BACKEND_URL (never in the bundle).
BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_CAMPUS_TIMEZONE=Asia/Kolkata   # display timezone for timestamps
# NEXT_PUBLIC_API_BASE_URL=        # only to bypass the proxy in development (then ACCESS_MODE=open)