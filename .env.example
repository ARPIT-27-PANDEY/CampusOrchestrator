# CampusOS AI configuration. Copy to .env and edit. Never commit .env.
# The backend reads these variables; the MCP servers read the *_PROVIDER / data variables.

# ---------------------------------------------------------------- LLM
# "mock" = deterministic offline provider (default; no key needed). "groq" = GroqCloud.
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
GROQ_MAX_COMPLETION_TOKENS=1024
GROQ_REASONING_EFFORT=low          # low | medium | high (GPT-OSS only)
GROQ_INCLUDE_REASONING=false       # keep reasoning tokens out of responses
GROQ_STREAM=true                   # falls back to non-streaming automatically if Groq rejects it
GROQ_TIMEOUT_S=30
GROQ_MAX_RETRIES=2                 # 429/5xx retries inside the OpenAI client (honours retry-after)

# ---------------------------------------------------------------- MCP servers (allowlisted)
# Defaults come from backend/config/mcp_servers.json. Override a URL, or set it empty to mark "not configured".
# MCP_LIBRARY_URL=http://localhost:8101/mcp
# MCP_EVENTS_URL=http://localhost:8102/mcp
# MCP_CAFETERIA_URL=http://localhost:8103/mcp
# MCP_ACADEMICS_URL=http://localhost:8104/mcp
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,library-mcp,events-mcp,cafeteria-mcp,academics-mcp

# ---------------------------------------------------------------- Agent budgets
MAX_AGENT_ITERATIONS=5
MAX_TOOL_CALLS=8
TOOL_TIMEOUT_S=8
TOOL_MAX_RETRIES=1
TOOL_EXECUTION_MODE=sequential     # GPT-OSS on Groq emits one call per turn; "concurrent" runs a turn's calls in parallel
MAX_QUERY_CHARS=2000
MAX_CONCURRENT_CHATS=4

# ---------------------------------------------------------------- API
CORS_ORIGINS=http://localhost:3000
ALLOW_FAULT_INJECTION=false        # true enables per-request simulated outages (demo/testing only)
LOG_LEVEL=INFO
LOG_JSON=false
# TRACE_LOG_PATH=./traces.jsonl    # optional JSONL persistence of traces

# ---------------------------------------------------------------- Data providers (MCP servers)
LIBRARY_PROVIDER=demo
EVENTS_PROVIDER=demo               # demo | google (read-only public calendar)
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=
CAMPUS_TIMEZONE=Asia/Kolkata
CAFETERIA_PROVIDER=demo            # demo | json | pdf
CAFETERIA_MENU_PATH=
# Academics / RAG
QDRANT_URL=                        # e.g. http://localhost:6333 ; empty = embedded store (QDRANT_PATH)
QDRANT_PATH=:memory:               # or a directory such as ./data/qdrant
QDRANT_COLLECTION=campus_handbooks
EMBEDDING_PROVIDER=hashing         # hashing (offline, lexical) | fastembed (pip install 'campusos-academics-mcp[fastembed]')
RAG_MIN_SCORE=0.12
ACADEMICS_DATA_MODE=demo           # demo | imported
# HANDBOOK_DIR=services/academics_mcp/data/handbooks

# ---------------------------------------------------------------- Frontend (build time)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
